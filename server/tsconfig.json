{
  "compilerOptions": {
    "target": "ESNext",
    "module": "Preserve",
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "allowJs": true,
    "composite": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    
    "rootDirs": [".", ".."],

    "paths": {
      "@contracts": ["../contracts.ts"],
      "@domain/*": ["./src/domains/*"],
      "@applications/*": ["./src/applications/*"],
      "@shared/*": ["./src/shared/*"],
      "@presentation/*": ["./src/presentation/*"],
      "@infra/*": ["./src/infra/*"],
      "@index/*": ["./src/*"]
    }
  },

  "include": [
    "src",
    "index.ts",
    "injection.ts",
    "env.d.ts",
    "../contracts.ts",
  ],

  "exclude": [
    "node_modules",
    "../node_modules"
  ]
}
